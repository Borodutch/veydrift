# Generated outputs from a local workspace must never reach the build: the
# image's bundle is the one the build phase produces.
apps/frontend/dist/
apps/frontend/.animation-variants/
# Pinned media (apps/frontend/media.json) is synced into a persistent mount at
# runtime and must never be copied into an image.
apps/frontend/.media/
apps/frontend/.media-src/
# Not read by any build or runtime. Nixpacks copies the source tree into each
# image, so everything here would be rewritten on every deploy.
**/node_modules/
.git/
docs/
.github/
/*.md
