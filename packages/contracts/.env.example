# Deployer wallet configuration for Veydrift contracts
# Copy to .env and fill in real values (never commit .env)

# Deployer private key (0x-prefixed hex)
# Stored in Vaultwarden under "Veydrift deployer wallet"
PRIVATE_KEY=0x...

# RPC URLs for Base networks
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Optional, only required for source verification
BASESCAN_API_KEY=...
