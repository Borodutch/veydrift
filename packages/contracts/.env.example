# Deployer wallet configuration for Veydrift contracts
# Copy to .env and fill in real values (never commit .env)

# Deployer private key (0x-prefixed hex)
# Stored in Vaultwarden under "Veydrift deployer wallet"
PRIVATE_KEY=0x...

# RPC URLs for Base networks
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Optional, only required for source verification
BASESCAN_API_KEY=...

# VEY-KANEO-741 Uniswap CCA/v4 launch tooling. These placeholders are not approvals.
# Never commit values, private keys, authenticated RPC URLs, or Vaultwarden material.
VEYDRIFT_LAUNCH_AUTHORITY=0xca6C67515aa9aa21DA37e07C7469Fd2C5880e2F4
# The fixed 500M genesis bootstrap allocation is minted only to the approved launch authority above.
VEYDRIFT_RESOURCE_LIQUIDITY_TREASURY=0x...
VEYDRIFT_DEVELOPMENT_BENEFICIARY=0x...
VEYDRIFT_CONTRIBUTOR_BENEFICIARY=0x...
VEYDRIFT_ECOSYSTEM_BENEFICIARY=0x...
# Required Unix timestamp: strictly future and no more than 30 days ahead at broadcast. Never use 0.
VEYDRIFT_VESTING_START_TIMESTAMP=<future-unix-timestamp>
VEYDRIFT_TOKEN_ADDRESS=0x...
VEYDRIFT_METAL_TOKEN_ADDRESS=0x...
VEYDRIFT_CRYSTAL_TOKEN_ADDRESS=0x...
VEYDRIFT_DEUTERIUM_TOKEN_ADDRESS=0x...
VEYDRIFT_V4_POSITION_BENEFICIARY=0x...
