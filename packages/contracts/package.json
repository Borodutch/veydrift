{
  "name": "@veydrift/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "forge build",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "check": "forge fmt --check && forge build --sizes && forge build && bun run storage:check",
    "storage:check": "forge build --force --extra-output storageLayout && node scripts/check-storage-layout.mjs",
    "test": "forge test --force"
  }
}
