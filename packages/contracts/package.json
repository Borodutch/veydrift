{
  "name": "@veydrift/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "forge build",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "check": "bun run check:fast && bun run check:storage",
    "check:fast": "forge fmt --check && forge build --sizes && forge build",
    "check:storage": "forge build --force --extra-output storageLayout && node scripts/check-storage-layout.mjs",
    "storage:check": "bun run check:storage",
    "test": "forge test",
    "manifest:check": "node scripts/validate-veydrift-uniswap-launch-manifest.mjs"
  }
}
