{
  "name": "veydrift",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.1.42",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:universe && bun run build:backend && bun run build:frontend && bun run build:contracts && bun run build:circuits && bun run build:keeper && bun run build:chicken-burn-listener",
    "build:backend": "cd apps/backend && bun run build",
    "build:keeper": "cd apps/battle-keeper && bun run build",
    "build:frontend": "cd apps/frontend && bun run build",
    "build:contracts": "cd packages/contracts && bun run build",
    "build:circuits": "cd packages/circuits && bun run build",
    "build:universe": "cd packages/universe && bun run build",
    "build:chicken-burn-listener": "cd apps/chicken-burn-listener && bun run build",
    "check": "bun run check:alpha-state && bun run check:docs && bun run check:universe && bun run check:backend && bun run check:frontend && bun run check:contracts && bun run check:circuits && bun run check:keeper && bun run check:chicken-burn-listener",
    "check:alpha-state": "node scripts/veydrift-alpha-state-preservation-check.mjs",
    "check:docs": "node scripts/veydrift-docs-content-check.mjs",
    "check:backend": "cd apps/backend && bun run check",
    "check:keeper": "cd apps/battle-keeper && bun run check",
    "check:frontend": "cd apps/frontend && bun run check",
    "check:contracts": "cd packages/contracts && bun run check",
    "check:contracts:fast": "cd packages/contracts && bun run check:fast",
    "check:contracts:storage": "cd packages/contracts && bun run check:storage",
    "check:circuits": "cd packages/circuits && bun run check",
    "check:universe": "cd packages/universe && bun run check",
    "check:chicken-burn-listener": "cd apps/chicken-burn-listener && bun run check",
    "ci:preflight": "node scripts/ci-run-scoped-checks.mjs",
    "dev:backend": "cd apps/backend && bun run dev",
    "dev:frontend": "cd apps/frontend && bun run dev",
    "dev:keeper": "cd apps/battle-keeper && bun run dev",
    "dev:chicken-burn-listener": "cd apps/chicken-burn-listener && bun run dev",
    "deploy:apply-manifest": "node scripts/veydrift-apply-deployment-manifest.mjs",
    "deploy:manifest": "node scripts/veydrift-deployment-manifest.mjs",
    "deploy:smoke": "node scripts/veydrift-postdeploy-smoke.mjs",
    "performance:api": "node scripts/veydrift-api-route-benchmark.mjs",
    "report:api-latency": "node scripts/veydrift-api-latency-report.mjs",
    "test": "bun run test:universe && bun run test:backend && bun run test:frontend && bun run test:contracts && bun run test:circuits && bun run test:keeper && bun run test:chicken-burn-listener",
    "test:api-latency-report": "node --test scripts/veydrift-api-latency-report.test.mjs scripts/veydrift-api-route-benchmark.test.mjs",
    "test:backend": "cd apps/backend && bun test",
    "test:keeper": "cd apps/battle-keeper && bun test",
    "test:frontend": "cd apps/frontend && bun run test",
    "test:contracts": "cd packages/contracts && bun run test",
    "test:circuits": "cd packages/circuits && bun run test",
    "test:universe": "cd packages/universe && bun run test",
    "test:chicken-burn-listener": "cd apps/chicken-burn-listener && bun run test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
