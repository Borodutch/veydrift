    "graphql-yoga": "^5.13.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@veydrift/config": "workspace:*",
    "@veydrift/types": "workspace:*",
    "typescript": "^5.8.0"
  }
}
