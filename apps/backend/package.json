{
  "name": "@veydrift/backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.1.42",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "tsc --project tsconfig.json",
    "dev": "bun --watch src/index.ts",
    "fleet-defense:parity": "bun src/fleetDefenseParityGuard.ts",
    "index:replay": "bun src/replayIndexer.ts",
    "index:seed-current": "bun src/replayIndexer.ts --current-state-seed --current-state-concurrency 25",
    "index:sync": "bun src/replayIndexer.ts",
    "migration:snapshot": "bun src/migrationSnapshot.ts",
    "mission-report:generator": "bun src/missionReportGenerator.ts",
    "randomness:oracle": "bun src/randomnessOracle.ts",
    "start": "bun src/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@veydrift/universe": "workspace:*",
    "viem": "^2.52.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.23",
    "typescript": "^5.9.3"
  }
}
