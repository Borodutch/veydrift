FROM oven/bun:1.2.4-alpine

WORKDIR /app
ARG GIT_SHA=""

COPY package.json bun.lockb tsconfig.base.json ./
COPY apps apps
COPY packages packages

RUN printf "%s" "$GIT_SHA" > .veydrift-backend-build-sha
RUN bun install --frozen-lockfile

WORKDIR /app/apps/backend
RUN bun run build

ENV NODE_ENV=production
ENV PORT=4000

# Readiness gate for start-first (zero-downtime) redeploys: the orchestrator must
# not route traffic to this container until GET /health answers 200, otherwise the
# old container is stopped while Bun is still binding the port and the redeploy
# drops requests. /health returns 200 only after the backend can serve public reads.
HEALTHCHECK --interval=15s --timeout=20s --start-period=120s --retries=6 \
  CMD ["bun", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT ?? '4000') + '/health').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["bun", "run", "start"]
