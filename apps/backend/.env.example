# Veydrift backend configuration
# Copy to .env and fill with real values. Never commit .env or secrets.

VEYDRIFT_DEPLOYMENT_MODE=local
VEYDRIFT_CHAIN_ID=84532
VEYDRIFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VEYDRIFT_SETTLEMENT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VEYDRIFT_GAME_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VEYDRIFT_SETTLEMENT_START_PRICE_WEI=50000000000000000
VEYDRIFT_ALLIANCE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VEYDRIFT_MOON_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VEYDRIFT_RANDOMNESS_ENGINE_ADDRESS=0x0000000000000000000000000000000000000000
VEYDRIFT_METAL_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VEYDRIFT_CRYSTAL_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VEYDRIFT_DEUTERIUM_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VEYDRIFT_INDEX_FROM_BLOCK=0
# Optional deployment/safe-history boundary for the currently configured referral contract. Defaults
# to VEYDRIFT_INDEX_FROM_BLOCK. Set it to the replacement referral deployment block to keep startup
# reconciliation bounded while still including migration-batch events.
VEYDRIFT_REFERRAL_INDEX_FROM_BLOCK=
VEYDRIFT_PAID_ALLIANCE_INVITE_ADDRESS=
# Exact deployment block for the one-time writer-owned paid-invite history backfill.
VEYDRIFT_PAID_ALLIANCE_INVITE_INDEX_FROM_BLOCK=
VEYDRIFT_PAID_ALLIANCE_INVITE_SIGNER_PRIVATE_KEY=
VEYDRIFT_PAID_ALLIANCE_INVITE_ENCRYPTION_KEY=
VEYDRIFT_PAID_ALLIANCE_INVITE_PREVIOUS_ENCRYPTION_KEYS=
VEYDRIFT_PAID_ALLIANCE_INVITE_SECRET_STORE_PATH=.data/paid-alliance-invites.sqlite

# Public Base mainnet Burning Chicken metadata surfaced through /runtime-config.
# These are contract addresses/selectors only; keep provider keys in secret storage.
VEYDRIFT_BURNING_CHICKEN_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VEYDRIFT_BURNING_CHICKEN_BURN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VEYDRIFT_BURNING_CHICKEN_BURN_SELECTOR=0x6364233d
VEYDRIFT_BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Optional target for the multi-worker pool size (VEY-KANEO-466). The backend runs N worker
# processes that share PORT via SO_REUSEPORT; worker 0 is the single chain indexer/writer and the rest
# are WAL readers that forward mutating POSTs to the writer. Defaults to min(host CPU count, 2) so
# memory-heavy indexed API containers do not spawn one reader per host CPU; set 1 to force the
# original single process. Values above 2 are clamped to the deploy-safe cap.
VEYDRIFT_WORKER_COUNT=

# Optional hard cap for deployed service configs. This can lower the built-in deploy-safe cap but cannot
# raise it; set 1 to keep a deployment single-process even if stale worker env vars remain configured.
VEYDRIFT_MAX_WORKER_COUNT=

# Optional override for the writer's private loopback listener that readers forward writes to. Defaults
# to PORT+1; only relevant when the pool has more than one worker. Set this if PORT+1 collides.
VEYDRIFT_WRITER_INTERNAL_PORT=

# Preferred when using the shared Alchemy credential from Vaultwarden.
ALCHEMY_BASE_SEPOLIA_API_KEY=

# Alternative explicit RPC URLs. Leave unset when using ALCHEMY_BASE_SEPOLIA_API_KEY.
VEYDRIFT_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ALCHEMY_BASE_SEPOLIA_RPC_URL=

# Optional per-request abort deadline (milliseconds) for upstream HTTP RPC calls. Bounds each fetch so
# a slow/hung Alchemy connection during a live-read timeout storm cannot accumulate orphaned sockets and
# crash the runtime. Defaults to 10000 when unset or non-positive.
VEYDRIFT_RPC_HTTP_TIMEOUT_MS=

# Optional websocket RPC override for chain-event subscriptions.
# If unset, ALCHEMY_BASE_SEPOLIA_API_KEY derives wss://base-sepolia.g.alchemy.com/v2/<key>.
VEYDRIFT_WS_RPC_URL=
BASE_SEPOLIA_WS_RPC_URL=
ALCHEMY_BASE_SEPOLIA_WS_RPC_URL=
ALCHEMY_BASE_SEPOLIA_WS_URL=
# One-shot in-writer fleet-mission current-state repair. Set an operator-approved unique run id for
# one managed deployment, verify the heal metadata/logs, then remove it from runtime configuration.
VEYDRIFT_CURRENT_STATE_HEAL_RUN_ID=
# One-shot retained-log repair for active research queues missing startedAt. Change the operator-approved
# run id for a new repair attempt; matching owner/item/targetLevel/readyAt is required before any write.
VEYDRIFT_RESEARCH_QUEUE_STARTED_AT_REPAIR_RUN_ID=
# One-shot canonical alliance-directory repair. Change the run id to execute a new operator-approved heal.
VEYDRIFT_ALLIANCE_STATE_HEAL_RUN_ID=
