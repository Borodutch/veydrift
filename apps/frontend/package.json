{
  "name": "@veydrift/frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.1.42",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --project tsconfig.json && vite build",
    "dev": "vite --host 0.0.0.0",
