FROM oven/bun:1.2.4-alpine@sha256:66169513f6c6c653b207a4f198695a3a9750ed0ae7b1088d4a8fc09a3a0d41dc

WORKDIR /app

COPY package.json bun.lockb tsconfig.base.json ./
COPY apps apps
COPY packages packages

RUN bun install --frozen-lockfile

WORKDIR /app/apps/frontend
RUN bun run build:test

ENV NODE_ENV=production
ENV PORT=80

CMD ["bun", "run", "serve"]
